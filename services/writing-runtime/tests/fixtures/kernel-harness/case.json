    {"assertion_id": "assert.benchmark-citations", "gate": "G4", "operator": "citation_fields_present", "expected": ["reference_id", "chapter_id", "chunk_id"], "required_evidence_kinds": ["artifact", "citation_report"], "required": true},
    {"assertion_id": "assert.skill-evidence", "gate": "G1", "operator": "activity_kind_present", "expected": "skill_call", "required_evidence_kinds": ["activity_stream", "artifact"], "required": true},
    {"assertion_id": "assert.changeset-artifact", "gate": "G2", "operator": "activity_kind_present", "expected": "change_proposal", "required_evidence_kinds": ["activity_stream", "changeset"], "required": true},
    {"assertion_id": "assert.formal-project-unchanged", "gate": "G4", "operator": "snapshot_unchanged", "expected": true, "required_evidence_kinds": ["workspace_snapshot"], "required": true},
    {"assertion_id": "assert.read-allow", "gate": "G2", "operator": "permission_effect", "expected": "allow", "required_evidence_kinds": ["permission_decision"], "required": true},
    {"assertion_id": "assert.write-ask", "gate": "G2", "operator": "permission_effect", "expected": "ask", "required_evidence_kinds": ["permission_decision"], "required": true},
    {"assertion_id": "assert.outside-deny", "gate": "G2", "operator": "permission_effect", "expected": "deny", "required_evidence_kinds": ["permission_decision"], "required": true},
    {"assertion_id": "assert.cancel-terminal", "gate": "G3", "operator": "status_equals", "expected": "cancelled", "required_evidence_kinds": ["activity_stream", "process_lifecycle"], "required": true},
    {"assertion_id": "assert.cancel-no-half-write", "gate": "G4", "operator": "snapshot_unchanged", "expected": true, "required_evidence_kinds": ["workspace_snapshot"], "required": true},
    {"assertion_id": "assert.resume-continuity", "gate": "G3", "operator": "status_equals", "expected": "resumed", "required_evidence_kinds": ["protocol_transcript", "process_lifecycle"], "required": true},
    {"assertion_id": "assert.event-sequence", "gate": "G3", "operator": "event_sequence_valid", "expected": true, "required_evidence_kinds": ["activity_stream"], "required": true},
    {"assertion_id": "assert.partial-hunks-only", "gate": "G2", "operator": "paths_changed_only", "expected": ["05_正文内容/第一卷/CH001_正文.md"], "required_evidence_kinds": ["changeset", "workspace_snapshot"], "required": true},
    {"assertion_id": "assert.stale-conflict", "gate": "G4", "operator": "conflict_rejected", "expected": true, "required_evidence_kinds": ["changeset", "workspace_snapshot"], "required": true},
    {"assertion_id": "assert.compaction-event", "gate": "G3", "operator": "activity_kind_present", "expected": "compaction", "required_evidence_kinds": ["activity_stream"], "required": true},
    {"assertion_id": "assert.citation-hash-stable", "gate": "G3", "operator": "artifact_hash_stable", "expected": true, "required_evidence_kinds": ["artifact", "citation_report"], "required": true},
    {"assertion_id": "assert.cleanup-fixture", "gate": "G5", "operator": "cleanup_no_diff", "expected": true, "required_evidence_kinds": ["cleanup_report", "workspace_snapshot"], "required": true},
    {"assertion_id": "assert.cleanup-user-roots", "gate": "G5", "operator": "cleanup_no_diff", "expected": true, "required_evidence_kinds": ["cleanup_report"], "required": true}
