  "steps": [
    {
      "step_id": "step.prepare",
      "ordinal": 1,
      "operation": "prepare",
      "objective": "Copy the fixed fixture into an isolated run directory and record source and project fingerprints.",
      "timeout_seconds": 30,
      "assertion_ids": ["assert.fixture-integrity"],
      "required_capabilities": [],
      "expected_activity_kinds": []
    },
    {
      "step_id": "step.transport-handshake",
      "ordinal": 2,
      "operation": "transport_handshake",
      "objective": "Start the isolated sidecar and verify its pinned transport handshake without claiming workflow health.",
      "timeout_seconds": 60,
      "assertion_ids": ["assert.transport-handshake", "assert.capability-snapshot", "assert.skill-isolation"],
      "required_capabilities": ["streaming", "cancel"],
      "expected_activity_kinds": []
    },
    {
      "step_id": "step.bind-snapshot",
      "ordinal": 3,
      "operation": "bind_snapshot",
      "objective": "Create a session bound to the read-only project revision and the two reference roots.",
      "timeout_seconds": 60,
      "assertion_ids": ["assert.project-bound-readonly"],
      "required_capabilities": ["file_read"],
      "expected_activity_kinds": []
    },
    {
      "step_id": "step.benchmark-turn",
      "ordinal": 4,
      "operation": "benchmark_turn",
      "objective": "Compare opening pressure, information reveal, conflict escalation, and chapter-end payoff with resolvable citations.",
      "timeout_seconds": 300,
      "assertion_ids": ["assert.benchmark-citations"],
      "required_capabilities": ["streaming", "tool_calls", "file_read", "artifacts"],
      "expected_activity_kinds": ["message", "tool_call", "tool_result", "artifact"]
    },
    {
      "step_id": "step.skill-call",
      "ordinal": 5,
      "operation": "skill_call",
      "objective": "Invoke executor-test-skill with a pinned manifest revision and produce the benchmark artifact.",
      "timeout_seconds": 300,
      "assertion_ids": ["assert.skill-evidence"],
      "required_capabilities": ["skills", "artifacts"],
      "expected_activity_kinds": ["skill_call", "artifact"]
    },
    {
      "step_id": "step.change-turn",
      "ordinal": 6,
      "operation": "change_turn",
      "objective": "Propose synchronized Markdown and JSON changes under staging without writing the formal project.",
      "timeout_seconds": 300,
      "assertion_ids": ["assert.changeset-artifact", "assert.formal-project-unchanged"],
      "required_capabilities": ["file_read", "file_write", "artifacts"],
      "expected_activity_kinds": ["change_proposal", "artifact"]
    },
    {
      "step_id": "step.permission-matrix",
      "ordinal": 7,
      "operation": "permission_matrix",
      "objective": "Observe read allow, staging write ask, and out-of-scope write deny as three separate decisions.",
      "timeout_seconds": 180,
      "assertion_ids": ["assert.read-allow", "assert.write-ask", "assert.outside-deny"],
      "required_capabilities": ["approvals", "file_read", "file_write"],
      "expected_activity_kinds": ["approval_request"]
    },
    {
      "step_id": "step.cancel",
      "ordinal": 8,
      "operation": "cancel_long_tool",
      "objective": "Cancel a deterministic long tool and prove no false success or partial write.",
      "timeout_seconds": 120,
      "assertion_ids": ["assert.cancel-terminal", "assert.cancel-no-half-write"],
      "required_capabilities": ["cancel", "tool_calls"],
      "expected_activity_kinds": ["tool_call", "tool_result"]
    },
    {
      "step_id": "step.restart-resume",
      "ordinal": 9,
      "operation": "restart_resume",
      "objective": "Restart the sidecar, resume the same session, and continue from a duplicate-free event cursor.",
      "timeout_seconds": 180,
      "assertion_ids": ["assert.resume-continuity", "assert.event-sequence"],
      "required_capabilities": ["resume", "streaming"],
      "expected_activity_kinds": ["message"]
    },
    {
      "step_id": "step.partial-accept",
      "ordinal": 10,
      "operation": "partial_hunk_accept",
      "objective": "Accept selected hunks only inside the disposable project copy.",
      "timeout_seconds": 120,
      "assertion_ids": ["assert.partial-hunks-only"],
      "required_capabilities": ["approvals", "file_write"],
      "expected_activity_kinds": ["change_proposal", "approval_request"]
    },
    {
      "step_id": "step.revision-conflict",
      "ordinal": 11,
      "operation": "inject_revision_conflict",
      "objective": "Advance the disposable project revision externally and reject the stale candidate base.",
      "timeout_seconds": 120,
      "assertion_ids": ["assert.stale-conflict"],
      "required_capabilities": ["file_read", "file_write"],
      "expected_activity_kinds": ["error"]
    },
    {
      "step_id": "step.compaction-followup",
      "ordinal": 12,
      "operation": "compact_followup",
      "objective": "Compact context and verify citation and approved-decision continuity without exact prose comparison.",
      "timeout_seconds": 300,
      "assertion_ids": ["assert.compaction-event", "assert.citation-hash-stable"],
      "required_capabilities": ["compaction", "artifacts"],
      "expected_activity_kinds": ["compaction", "message"]
    },
    {
      "step_id": "step.cleanup",
      "ordinal": 13,
      "operation": "cleanup",
      "objective": "Remove run state and prove no changes to real HOME, USERPROFILE, Skill/MCP roots, or the source fixture.",
      "timeout_seconds": 60,
      "assertion_ids": ["assert.cleanup-fixture", "assert.cleanup-user-roots"],
      "required_capabilities": [],
      "expected_activity_kinds": []
    }
  ],
