ZHIMENG_ENVIRONMENT=development
ZHIMENG_HOST=127.0.0.1
ZHIMENG_PORT=8787
ZHIMENG_DATABASE_PATH=.runtime/writing-runtime.sqlite3
ZHIMENG_BACKUP_ROOT=
# JSON array or semicolon-separated absolute paths. Empty disables project access.
ZHIMENG_TRUSTED_PROJECT_ROOTS=[]
# JSON array or semicolon-separated absolute paths. Empty disables skill discovery.
ZHIMENG_TRUSTED_SKILL_ROOTS=[]
# Optional development adapters. Runtime never auto-discovers user-level Skills
# or downloader scripts; production packaging must replace these with project-owned code.
ZHIMENG_TOMATO_SKILL_ROOT=
ZHIMENG_TOMATO_DOWNLOADER_SCRIPT=
ZHIMENG_DISTILLATION_SKILL_ROOT=
ZHIMENG_DISTILLATION_LIBRARY=
ZHIMENG_DISTILLATION_PYTHON_EXECUTABLE=
ZHIMENG_DISTILLATION_TIMEOUT_SECONDS=120

# Writing Agent provider. Leave both URL/model empty to expose an explicit
# unavailable state instead of returning fixture text.
ZHIMENG_AGENT_PROVIDER_BASE_URL=
ZHIMENG_AGENT_PROVIDER_API_KEY=
# Non-secret credential slot identity. Change it when account or permission semantics change.
ZHIMENG_AGENT_PROVIDER_CREDENTIAL_REFERENCE=
ZHIMENG_AGENT_PROVIDER_MODEL=
# Optional explicit aliases that the configured gateway may report. No fuzzy matching.
ZHIMENG_AGENT_PROVIDER_ACCEPTED_REPORTED_MODELS=
ZHIMENG_AGENT_PROVIDER_TIMEOUT_SECONDS=120
ZHIMENG_AGENT_PROVIDER_MAX_TOKENS=4096
ZHIMENG_AGENT_PROVIDER_TEMPERATURE=0.7
ZHIMENG_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ZHIMENG_SSE_HEARTBEAT_SECONDS=15

