{
  "$defs": {
    "QueueItem": {
      "additionalProperties": false,
      "properties": {
        "delivery": {
          "default": "queued",
          "enum": [
            "queued",
            "steer_pending"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "image_ids": {
          "items": {
            "type": "string"
          },
          "title": "Image Ids",
          "type": "array"
        },
        "item_id": {
          "pattern": "^[a-zA-Z0-9-]{8,64}$",
          "title": "Item Id",
          "type": "string"
        },
        "manual_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Manual File Ids",
          "type": "array"
        },
        "manual_skill_names": {
          "items": {
            "type": "string"
          },
          "title": "Manual Skill Names",
          "type": "array"
        },
        "message": {
          "default": "",
          "maxLength": 100000,
          "title": "Message",
          "type": "string"
        },
        "open_file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open File Path"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "sending": {
          "default": false,
          "title": "Sending",
          "type": "boolean"
        },
        "steering_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steering Run Id"
        },
        "writer_mode": {
          "default": "repair_only",
          "enum": [
            "repair_only",
            "author_review_change_proposal"
          ],
          "title": "Writer Mode",
          "type": "string"
        }
      },
      "required": [
        "item_id"
      ],
      "title": "QueueItem",
      "type": "object"
    },
    "QueueState": {
      "properties": {
        "active_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Run Id"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/QueueItem"
          },
          "title": "Items",
          "type": "array"
        },
        "pause_reason": {
          "anyOf": [
            {
              "enum": [
                "user",
                "failed",
                "cancelled",
                "interrupted",
                "send_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pause Reason"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "revision"
      ],
      "title": "QueueState",
      "type": "object"
    }
  },
  "$id": "https://zhimeng.local/contracts/agent-queue-steer-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "queue": {
      "$ref": "#/$defs/QueueState"
    }
  },
  "required": [
    "queue"
  ],
  "title": "QueueSteerResponse",
  "type": "object"
}
