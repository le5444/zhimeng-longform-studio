{
  "$id": "https://zhimeng.local/contracts/provider-settings-update.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "api_key": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Key"
    },
    "base_url": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Url"
    },
    "context_window": {
      "anyOf": [
        {
          "enum": [
            "256k",
            "1m"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Window"
    },
    "expected_revision": {
      "anyOf": [
        {
          "pattern": "^(?:[a-f0-9]{64}|missing)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "reasoning_effort": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoning Effort"
    },
    "wire_format": {
      "anyOf": [
        {
          "enum": [
            "chat",
            "responses",
            "anthropic_messages"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wire Format"
    }
  },
  "title": "ProviderSettingsUpdate",
  "type": "object"
}
