{
  "$defs": {
    "CreationInstructionActivationScope": {
      "additionalProperties": false,
      "properties": {
        "scope_type": {
          "enum": [
            "application",
            "project"
          ],
          "title": "Scope Type",
          "type": "string"
        },
        "scope_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Scope Key",
          "type": "string"
        },
        "configured_state": {
          "enum": [
            "unconfigured",
            "inherited",
            "enabled",
            "disabled"
          ],
          "title": "Configured State",
          "type": "string"
        },
        "state_revision": {
          "minimum": 0,
          "title": "State Revision",
          "type": "integer"
        },
        "activation_receipt_id": {
          "anyOf": [
            {
              "pattern": "^skill-activation-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Receipt Id"
        },
        "activation_receipt_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Receipt Hash"
        },
        "configured_version_id": {
          "anyOf": [
            {
              "pattern": "^skill-version-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configured Version Id"
        }
      },
      "required": [
        "scope_type",
        "scope_key",
        "configured_state",
        "state_revision"
      ],
      "title": "CreationInstructionActivationScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.creation-instruction-activation.v1",
      "title": "Schema",
      "type": "string"
    },
    "activation_binding_id": {
      "pattern": "^creation-instruction-activation-[0-9a-f]{32}$",
      "title": "Activation Binding Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "workflow_plan_id": {
      "pattern": "^workflow-plan-[0-9a-f]{32}$",
      "title": "Workflow Plan Id",
      "type": "string"
    },
    "workflow_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workflow Plan Hash",
      "type": "string"
    },
    "skill_id": {
      "const": "novel-creation-suite.writer-instruction",
      "title": "Skill Id",
      "type": "string"
    },
    "scope_chain": {
      "items": {
        "$ref": "#/$defs/CreationInstructionActivationScope"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Scope Chain",
      "type": "array"
    },
    "effective_scope": {
      "enum": [
        "application",
        "project"
      ],
      "title": "Effective Scope",
      "type": "string"
    },
    "skill_version_id": {
      "pattern": "^skill-version-[0-9a-f]{32}$",
      "title": "Skill Version Id",
      "type": "string"
    },
    "skill_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]*$",
      "title": "Skill Version",
      "type": "string"
    },
    "manifest_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Fingerprint",
      "type": "string"
    },
    "package_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Fingerprint",
      "type": "string"
    },
    "instruction_map_path": {
      "const": "instruction-map.json",
      "title": "Instruction Map Path",
      "type": "string"
    },
    "instruction_map_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Instruction Map Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "binding_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Hash",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "activation_binding_id",
    "run_id",
    "project_id",
    "workflow_plan_id",
    "workflow_plan_hash",
    "skill_id",
    "scope_chain",
    "effective_scope",
    "skill_version_id",
    "skill_version",
    "manifest_fingerprint",
    "package_fingerprint",
    "instruction_map_path",
    "instruction_map_hash",
    "created_at",
    "binding_hash"
  ],
  "title": "CreationInstructionActivationBinding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/creation-instruction-activation.schema.json"
}
