{
  "$defs": {
    "RunContextCompaction": {
      "properties": {
        "folded_results": {
          "default": 0,
          "title": "Folded Results",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "title": "State",
          "type": "string"
        },
        "tokens_after": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens After"
        },
        "tokens_before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Before"
        }
      },
      "required": [
        "run_id",
        "state"
      ],
      "title": "RunContextCompaction",
      "type": "object"
    },
    "SessionCheckpointRecord": {
      "additionalProperties": false,
      "description": "一份已落库的会话摘要。\n\n落库后逐字节不再变化：注入时引用的就是这一份，所以同一次注入的重新校验\n结果稳定。``through_ordinal`` 是这份摘要覆盖到的最后一条消息序号，之后\n的消息仍原样留在历史窗口里。",
      "properties": {
        "checkpoint_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "reported_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Model"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema": {
          "const": "zhimeng.session-checkpoint.v1",
          "default": "zhimeng.session-checkpoint.v1",
          "title": "Schema",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Session Id",
          "type": "string"
        },
        "source_message_count": {
          "minimum": 2,
          "title": "Source Message Count",
          "type": "integer"
        },
        "through_ordinal": {
          "minimum": 2,
          "title": "Through Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "checkpoint_id",
        "session_id",
        "run_id",
        "through_ordinal",
        "source_message_count",
        "content",
        "content_hash",
        "reported_model",
        "created_at"
      ],
      "title": "SessionCheckpointRecord",
      "type": "object"
    }
  },
  "$id": "https://zhimeng.local/contracts/session-context-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "background_pending": {
      "title": "Background Pending",
      "type": "boolean"
    },
    "compacted_message_count": {
      "title": "Compacted Message Count",
      "type": "integer"
    },
    "compacting": {
      "title": "Compacting",
      "type": "boolean"
    },
    "latest_checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionCheckpointRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "message_count": {
      "title": "Message Count",
      "type": "integer"
    },
    "recent_message_count": {
      "title": "Recent Message Count",
      "type": "integer"
    },
    "run_compaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunContextCompaction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "const": "zhimeng.session-context-state.v1",
      "default": "zhimeng.session-context-state.v1",
      "title": "Schema",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "message_count",
    "recent_message_count",
    "compacted_message_count",
    "compacting",
    "background_pending",
    "latest_checkpoint"
  ],
  "title": "SessionContextState",
  "type": "object"
}
