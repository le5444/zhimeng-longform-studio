{
  "$defs": {
    "WritebackEvidenceReceipt": {
      "additionalProperties": false,
      "description": "Author-visible writeback evidence after Apply/Rollback.\n\nThis is a product-native receipt for the post-writeback evidence gap. It does\nnot implement original NLCL chapter/ops/usage semantics or auto state sync.",
      "properties": {
        "schema": {
          "const": "zhimeng.writeback-evidence-receipt.v1",
          "default": "zhimeng.writeback-evidence-receipt.v1",
          "title": "Schema",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^writeback-evidence-[0-9a-f]{32}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "change_set_id": {
          "pattern": "^changeset-[0-9a-f]{32}$",
          "title": "Change Set Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project-[0-9a-f]{24}$",
          "title": "Project Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "applied",
            "rolled_back"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "writeback_manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Writeback Manifest Hash",
          "type": "string"
        },
        "base_revision": {
          "minimum": 1,
          "title": "Base Revision",
          "type": "integer"
        },
        "base_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Fingerprint",
          "type": "string"
        },
        "result_revision": {
          "minimum": 1,
          "title": "Result Revision",
          "type": "integer"
        },
        "result_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Fingerprint",
          "type": "string"
        },
        "context_pack_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Pack Id"
        },
        "context_pack_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Pack Hash"
        },
        "route_receipt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Receipt Id"
        },
        "route_receipt_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Receipt Hash"
        },
        "knowledge_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Fingerprint"
        },
        "selected_card_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Selected Card Ids",
          "type": "array"
        },
        "source_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Run Id"
        },
        "formal_draft_authorization_receipt_id": {
          "anyOf": [
            {
              "pattern": "^formal-draft-auth-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formal Draft Authorization Receipt Id"
        },
        "formal_draft_authorization_receipt_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formal Draft Authorization Receipt Hash"
        },
        "formal_draft_allowed": {
          "const": false,
          "default": false,
          "title": "Formal Draft Allowed",
          "type": "boolean"
        },
        "quality_assessed": {
          "const": false,
          "default": false,
          "title": "Quality Assessed",
          "type": "boolean"
        },
        "novel_state_synced": {
          "const": false,
          "default": false,
          "title": "Novel State Synced",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Hash",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "change_set_id",
        "project_id",
        "outcome",
        "writeback_manifest_hash",
        "base_revision",
        "base_fingerprint",
        "result_revision",
        "result_fingerprint",
        "created_at",
        "receipt_hash"
      ],
      "title": "WritebackEvidenceReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.writeback-evidence-response.v1",
      "default": "zhimeng.writeback-evidence-response.v1",
      "title": "Schema",
      "type": "string"
    },
    "change_set_id": {
      "pattern": "^changeset-[0-9a-f]{32}$",
      "title": "Change Set Id",
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/WritebackEvidenceReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "history": {
      "items": {
        "$ref": "#/$defs/WritebackEvidenceReceipt"
      },
      "maxItems": 32,
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "change_set_id"
  ],
  "title": "WritebackEvidenceResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/writeback-evidence-response.schema.json"
}
