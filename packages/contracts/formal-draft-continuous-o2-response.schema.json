{
  "$defs": {
    "FormalDraftContinuousO2Check": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/FormalDraftContinuousO2CheckCode"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "detail": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        }
      },
      "required": [
        "code",
        "required",
        "present",
        "detail"
      ],
      "title": "FormalDraftContinuousO2Check",
      "type": "object"
    },
    "FormalDraftContinuousO2CheckCode": {
      "enum": [
        "project_bound",
        "four_skills_continuous_linked",
        "adjacent_o2_chain_succeeded",
        "managed_skill_chain_succeeded",
        "creation_suite_continuous_evidence",
        "instruction_chain_handoff_bound"
      ],
      "title": "FormalDraftContinuousO2CheckCode",
      "type": "string"
    },
    "FormalDraftContinuousO2Receipt": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "zhimeng.formal-draft-continuous-o2-receipt.v1",
          "default": "zhimeng.formal-draft-continuous-o2-receipt.v1",
          "title": "Schema",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^formal-draft-continuous-o2-[0-9a-f]{32}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project-[0-9a-f]{24}$",
          "title": "Project Id",
          "type": "string"
        },
        "project_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Revision"
        },
        "project_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Fingerprint"
        },
        "status": {
          "$ref": "#/$defs/FormalDraftContinuousO2Status"
        },
        "authorization_input_ready": {
          "title": "Authorization Input Ready",
          "type": "boolean"
        },
        "authorization_unlock": {
          "const": false,
          "default": false,
          "title": "Authorization Unlock",
          "type": "boolean"
        },
        "formal_draft_allowed": {
          "const": false,
          "default": false,
          "title": "Formal Draft Allowed",
          "type": "boolean"
        },
        "writes_project_truth": {
          "const": false,
          "default": false,
          "title": "Writes Project Truth",
          "type": "boolean"
        },
        "four_skills_generic_exactly_once": {
          "const": false,
          "default": false,
          "title": "Four Skills Generic Exactly Once",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/FormalDraftContinuousO2Check"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "missing_required": {
          "items": {
            "$ref": "#/$defs/FormalDraftContinuousO2CheckCode"
          },
          "maxItems": 32,
          "title": "Missing Required",
          "type": "array"
        },
        "adjacent_chain_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjacent Chain Id"
        },
        "managed_skill_chain_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Managed Skill Chain Id"
        },
        "creation_suite_chain_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creation Suite Chain Id"
        },
        "source_import_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Import Id"
        },
        "formalization_receipt_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formalization Receipt Id"
        },
        "four_skills_continuous_receipt_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Four Skills Continuous Receipt Id"
        },
        "instruction_chain_handoff_binding_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction Chain Handoff Binding Id"
        },
        "instruction_chain_handoff_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction Chain Handoff Id"
        },
        "policy_version": {
          "const": "local-v1-continuous-o2-3",
          "default": "local-v1-continuous-o2-3",
          "title": "Policy Version",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Hash",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "project_id",
        "status",
        "authorization_input_ready",
        "checks",
        "evaluated_at",
        "receipt_hash"
      ],
      "title": "FormalDraftContinuousO2Receipt",
      "type": "object"
    },
    "FormalDraftContinuousO2Status": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "FormalDraftContinuousO2Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.formal-draft-continuous-o2-response.v1",
      "default": "zhimeng.formal-draft-continuous-o2-response.v1",
      "title": "Schema",
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/FormalDraftContinuousO2Receipt"
    },
    "not_claiming": {
      "default": [
        "formal_prose_writeback",
        "formal_draft_authorization_unlock",
        "four_skills_generic_exactly_once",
        "literary_quality_gate_complete",
        "local_v1_exe"
      ],
      "items": {
        "type": "string"
      },
      "title": "Not Claiming",
      "type": "array"
    }
  },
  "required": [
    "receipt"
  ],
  "title": "FormalDraftContinuousO2Response",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/formal-draft-continuous-o2-response.schema.json"
}
