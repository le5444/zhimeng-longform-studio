{
  "$defs": {
    "EvalSuiteBlindMemberView": {
      "additionalProperties": false,
      "properties": {
        "member_token": {
          "pattern": "^eval-member-[0-9a-f]{24}$",
          "title": "Member Token",
          "type": "string"
        },
        "ordinal": {
          "maximum": 32,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "present_artifact_kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Present Artifact Kinds",
          "type": "array"
        }
      },
      "required": [
        "member_token",
        "ordinal"
      ],
      "title": "EvalSuiteBlindMemberView",
      "type": "object"
    },
    "EvalSuiteBlindScore": {
      "additionalProperties": false,
      "properties": {
        "member_token": {
          "pattern": "^eval-member-[0-9a-f]{24}$",
          "title": "Member Token",
          "type": "string"
        },
        "score": {
          "maximum": 5,
          "minimum": 1,
          "title": "Score",
          "type": "integer"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "member_token",
        "score"
      ],
      "title": "EvalSuiteBlindScore",
      "type": "object"
    },
    "EvalSuiteCompareCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "detail": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "present",
        "detail"
      ],
      "title": "EvalSuiteCompareCheck",
      "type": "object"
    },
    "EvalSuiteMemberRecord": {
      "additionalProperties": false,
      "properties": {
        "member_token": {
          "pattern": "^eval-member-[0-9a-f]{24}$",
          "title": "Member Token",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project-[0-9a-f]{24}$",
          "title": "Project Id",
          "type": "string"
        },
        "change_set_id": {
          "pattern": "^changeset-[0-9a-f]{32}$",
          "title": "Change Set Id",
          "type": "string"
        },
        "baseline_receipt_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Baseline Receipt Id",
          "type": "string"
        },
        "baseline_receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Receipt Hash",
          "type": "string"
        },
        "export_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Export File Sha256",
          "type": "string"
        },
        "present_artifact_kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Present Artifact Kinds",
          "type": "array"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "reveal_after_finalize": {
          "const": true,
          "default": true,
          "title": "Reveal After Finalize",
          "type": "boolean"
        }
      },
      "required": [
        "member_token",
        "project_id",
        "change_set_id",
        "baseline_receipt_id",
        "baseline_receipt_hash",
        "export_file_sha256"
      ],
      "title": "EvalSuiteMemberRecord",
      "type": "object"
    },
    "EvalSuiteReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "zhimeng.eval-suite-receipt.v1",
          "default": "zhimeng.eval-suite-receipt.v1",
          "title": "Schema",
          "type": "string"
        },
        "suite_id": {
          "pattern": "^eval-suite-[0-9a-f]{32}$",
          "title": "Suite Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvalSuiteStatus"
        },
        "state_revision": {
          "minimum": 0,
          "title": "State Revision",
          "type": "integer"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/EvalSuiteMemberRecord"
          },
          "maxItems": 32,
          "minItems": 2,
          "title": "Members",
          "type": "array"
        },
        "member_count": {
          "maximum": 32,
          "minimum": 2,
          "title": "Member Count",
          "type": "integer"
        },
        "frozen": {
          "title": "Frozen",
          "type": "boolean"
        },
        "compare_against_suite_id": {
          "anyOf": [
            {
              "pattern": "^eval-suite-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compare Against Suite Id"
        },
        "compare_status": {
          "default": "deferred",
          "enum": [
            "deferred",
            "non_degraded",
            "degraded"
          ],
          "title": "Compare Status",
          "type": "string"
        },
        "compare_checks": {
          "items": {
            "$ref": "#/$defs/EvalSuiteCompareCheck"
          },
          "maxItems": 32,
          "title": "Compare Checks",
          "type": "array"
        },
        "blind_review_open": {
          "default": false,
          "title": "Blind Review Open",
          "type": "boolean"
        },
        "blind_review_finalized": {
          "default": false,
          "title": "Blind Review Finalized",
          "type": "boolean"
        },
        "blind_scores": {
          "items": {
            "$ref": "#/$defs/EvalSuiteBlindScore"
          },
          "maxItems": 32,
          "title": "Blind Scores",
          "type": "array"
        },
        "reveal_member_identities": {
          "default": false,
          "title": "Reveal Member Identities",
          "type": "boolean"
        },
        "formal_draft_allowed": {
          "const": false,
          "default": false,
          "title": "Formal Draft Allowed",
          "type": "boolean"
        },
        "quality_assessed": {
          "const": false,
          "default": false,
          "title": "Quality Assessed",
          "type": "boolean"
        },
        "training_ready": {
          "const": false,
          "default": false,
          "title": "Training Ready",
          "type": "boolean"
        },
        "auto_upgrade": {
          "const": false,
          "default": false,
          "title": "Auto Upgrade",
          "type": "boolean"
        },
        "policy_version": {
          "const": "local-v1-eval-suite-1",
          "default": "local-v1-eval-suite-1",
          "title": "Policy Version",
          "type": "string"
        },
        "detail": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Hash",
          "type": "string"
        }
      },
      "required": [
        "suite_id",
        "title",
        "summary",
        "status",
        "state_revision",
        "members",
        "member_count",
        "frozen",
        "detail",
        "updated_at",
        "receipt_hash"
      ],
      "title": "EvalSuiteReceipt",
      "type": "object"
    },
    "EvalSuiteStatus": {
      "enum": [
        "prepared",
        "frozen",
        "compare_ready",
        "compare_degraded",
        "blind_review_open",
        "blind_review_finalized"
      ],
      "title": "EvalSuiteStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.eval-suite-response.v1",
      "default": "zhimeng.eval-suite-response.v1",
      "title": "Schema",
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/EvalSuiteReceipt"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/EvalSuiteReceipt"
      },
      "maxItems": 32,
      "title": "History",
      "type": "array"
    },
    "blind_member_views": {
      "items": {
        "$ref": "#/$defs/EvalSuiteBlindMemberView"
      },
      "maxItems": 32,
      "title": "Blind Member Views",
      "type": "array"
    },
    "not_claiming": {
      "default": [
        "formal_draft_authorization_unlock",
        "literary_quality_score",
        "training_dataset_ready",
        "four_skills_generic_exactly_once",
        "local_v1_exe"
      ],
      "items": {
        "type": "string"
      },
      "title": "Not Claiming",
      "type": "array"
    }
  },
  "required": [
    "receipt"
  ],
  "title": "EvalSuiteResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/eval-suite-response.schema.json"
}
