{
  "$defs": {
    "EvalSuiteListItem": {
      "additionalProperties": false,
      "properties": {
        "suite_id": {
          "pattern": "^eval-suite-[0-9a-f]{32}$",
          "title": "Suite Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvalSuiteStatus"
        },
        "member_count": {
          "maximum": 32,
          "minimum": 2,
          "title": "Member Count",
          "type": "integer"
        },
        "frozen": {
          "title": "Frozen",
          "type": "boolean"
        },
        "blind_review_finalized": {
          "title": "Blind Review Finalized",
          "type": "boolean"
        },
        "formal_draft_allowed": {
          "const": false,
          "default": false,
          "title": "Formal Draft Allowed",
          "type": "boolean"
        },
        "quality_assessed": {
          "const": false,
          "default": false,
          "title": "Quality Assessed",
          "type": "boolean"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Hash",
          "type": "string"
        }
      },
      "required": [
        "suite_id",
        "title",
        "status",
        "member_count",
        "frozen",
        "blind_review_finalized",
        "updated_at",
        "receipt_hash"
      ],
      "title": "EvalSuiteListItem",
      "type": "object"
    },
    "EvalSuiteStatus": {
      "enum": [
        "prepared",
        "frozen",
        "compare_ready",
        "compare_degraded",
        "blind_review_open",
        "blind_review_finalized"
      ],
      "title": "EvalSuiteStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.eval-suite-list-response.v1",
      "default": "zhimeng.eval-suite-list-response.v1",
      "title": "Schema",
      "type": "string"
    },
    "suites": {
      "items": {
        "$ref": "#/$defs/EvalSuiteListItem"
      },
      "maxItems": 128,
      "title": "Suites",
      "type": "array"
    },
    "not_claiming": {
      "default": [
        "formal_draft_authorization_unlock",
        "training_dataset_ready",
        "local_v1_exe"
      ],
      "items": {
        "type": "string"
      },
      "title": "Not Claiming",
      "type": "array"
    }
  },
  "title": "EvalSuiteListResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/eval-suite-list-response.schema.json"
}
