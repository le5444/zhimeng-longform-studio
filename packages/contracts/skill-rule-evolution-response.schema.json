{
  "$defs": {
    "SkillRuleEvolutionCompareStatus": {
      "enum": [
        "deferred",
        "non_degraded",
        "degraded",
        "missing_baseline",
        "missing_export"
      ],
      "title": "SkillRuleEvolutionCompareStatus",
      "type": "string"
    },
    "SkillRuleEvolutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "zhimeng.skill-rule-evolution-receipt.v1",
          "default": "zhimeng.skill-rule-evolution-receipt.v1",
          "title": "Schema",
          "type": "string"
        },
        "evolution_id": {
          "pattern": "^skill-rule-evolution-[0-9a-f]{32}$",
          "title": "Evolution Id",
          "type": "string"
        },
        "skill_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "pattern": "^project-[0-9a-f]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "change_set_id": {
          "anyOf": [
            {
              "pattern": "^changeset-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Set Id"
        },
        "status": {
          "$ref": "#/$defs/SkillRuleEvolutionStatus"
        },
        "from_version_id": {
          "pattern": "^skill-version-[0-9a-f]{32}$",
          "title": "From Version Id",
          "type": "string"
        },
        "from_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "From Version",
          "type": "string"
        },
        "from_package_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "From Package Fingerprint",
          "type": "string"
        },
        "to_version_id": {
          "pattern": "^skill-version-[0-9a-f]{32}$",
          "title": "To Version Id",
          "type": "string"
        },
        "to_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "To Version",
          "type": "string"
        },
        "to_package_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "To Package Fingerprint",
          "type": "string"
        },
        "freeze_recorded": {
          "const": true,
          "default": true,
          "title": "Freeze Recorded",
          "type": "boolean"
        },
        "compare_status": {
          "$ref": "#/$defs/SkillRuleEvolutionCompareStatus"
        },
        "eval_corpus_baseline_receipt_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Corpus Baseline Receipt Id"
        },
        "eval_corpus_regression_receipt_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Corpus Regression Receipt Id"
        },
        "activation_receipt_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Receipt Id"
        },
        "activation_state_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation State Revision"
        },
        "auto_upgrade": {
          "const": false,
          "default": false,
          "title": "Auto Upgrade",
          "type": "boolean"
        },
        "formal_draft_allowed": {
          "const": false,
          "default": false,
          "title": "Formal Draft Allowed",
          "type": "boolean"
        },
        "quality_assessed": {
          "const": false,
          "default": false,
          "title": "Quality Assessed",
          "type": "boolean"
        },
        "policy_version": {
          "const": "local-v1-skill-rule-evolution-1",
          "default": "local-v1-skill-rule-evolution-1",
          "title": "Policy Version",
          "type": "string"
        },
        "detail": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Hash",
          "type": "string"
        }
      },
      "required": [
        "evolution_id",
        "skill_id",
        "status",
        "from_version_id",
        "from_version",
        "from_package_fingerprint",
        "to_version_id",
        "to_version",
        "to_package_fingerprint",
        "compare_status",
        "detail",
        "updated_at",
        "receipt_hash"
      ],
      "title": "SkillRuleEvolutionReceipt",
      "type": "object"
    },
    "SkillRuleEvolutionStatus": {
      "enum": [
        "prepared",
        "compare_ready",
        "compare_blocked",
        "applied",
        "rolled_back"
      ],
      "title": "SkillRuleEvolutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.skill-rule-evolution-response.v1",
      "default": "zhimeng.skill-rule-evolution-response.v1",
      "title": "Schema",
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/SkillRuleEvolutionReceipt"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/SkillRuleEvolutionReceipt"
      },
      "maxItems": 32,
      "title": "History",
      "type": "array"
    },
    "not_claiming": {
      "default": [
        "four_skills_generic_exactly_once",
        "automatic_skill_rule_upgrade",
        "formal_prose_writeback",
        "local_v1_exe"
      ],
      "items": {
        "type": "string"
      },
      "title": "Not Claiming",
      "type": "array"
    }
  },
  "required": [
    "receipt"
  ],
  "title": "SkillRuleEvolutionResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/skill-rule-evolution-response.schema.json"
}
