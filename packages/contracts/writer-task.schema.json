{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/writer-task.schema.json",
  "$defs": {
    "WriterTargetFile": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "pattern": "^file-[0-9a-f]{32}$",
          "title": "File Id",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^./\\\\:<>\"|?*\\x00-\\x1f](?:[^/\\\\:<>\"|?*\\x00-\\x1f]*[^./\\\\:<>\"|?*\\x00-\\x1f ])?(?:/[^./\\\\:<>\"|?*\\x00-\\x1f](?:[^/\\\\:<>\"|?*\\x00-\\x1f]*[^./\\\\:<>\"|?*\\x00-\\x1f ])?)*\\.(?:json|jsonl|md|txt|yaml|yml)$",
          "title": "Relative Path",
          "type": "string",
          "x-zhimeng-invariants": [
            "path segments cannot use Windows device names",
            "path segments are at most 255 characters",
            "folders inside the book are the author's own layout",
            "project files must use a supported text suffix"
          ]
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "content_role": {
          "default": "prose_body",
          "enum": [
            "prose_body",
            "project_file"
          ],
          "title": "Content Role",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "relative_path",
        "content_hash"
      ],
      "title": "WriterTargetFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.writer-task.v1",
      "default": "zhimeng.writer-task.v1",
      "title": "Schema",
      "type": "string"
    },
    "writer_task_id": {
      "pattern": "^writer-task-[0-9a-f]{32}$",
      "title": "Writer Task Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "repair_only",
        "author_review_change_proposal"
      ],
      "title": "Mode",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "workflow_plan_id": {
      "pattern": "^workflow-plan-[0-9a-f]{32}$",
      "title": "Workflow Plan Id",
      "type": "string"
    },
    "workflow_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workflow Plan Hash",
      "type": "string"
    },
    "final_checkpoint_id": {
      "pattern": "^workflow-checkpoint-[0-9a-f]{32}$",
      "title": "Final Checkpoint Id",
      "type": "string"
    },
    "final_checkpoint_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Final Checkpoint Hash",
      "type": "string"
    },
    "creation_handoff_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Creation Handoff Hash",
      "type": "string"
    },
    "creation_handoff_status": {
      "enum": [
        "blocked",
        "risk_draft_only"
      ],
      "title": "Creation Handoff Status",
      "type": "string"
    },
    "context_pack_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Context Pack Id",
      "type": "string"
    },
    "context_pack_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Pack Hash",
      "type": "string"
    },
    "route_receipt_id": {
      "pattern": "^nlcl-route-[0-9a-f]{32}$",
      "title": "Route Receipt Id",
      "type": "string"
    },
    "route_receipt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Route Receipt Hash",
      "type": "string"
    },
    "operation_package_id": {
      "pattern": "^prewrite-package-[0-9a-f]{32}$",
      "title": "Operation Package Id",
      "type": "string"
    },
    "operation_package_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Operation Package Hash",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "project_revision": {
      "minimum": 1,
      "title": "Project Revision",
      "type": "integer"
    },
    "project_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Fingerprint",
      "type": "string"
    },
    "active_chapter_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Chapter Id"
    },
    "task_goal": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Task Goal",
      "type": "string"
    },
    "failure_signatures": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Failure Signatures",
      "type": "array"
    },
    "target_files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WriterTargetFile"
      },
      "maxItems": 32,
      "title": "Target Files",
      "type": "array"
    },
    "target_files_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Files Hash",
      "type": "string"
    },
    "knowledge_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Knowledge Fingerprint"
    },
    "selected_card_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "title": "Selected Card Ids",
      "type": "array"
    },
    "selected_card_hashes": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 24,
      "title": "Selected Card Hashes",
      "type": "array"
    },
    "formal_draft_allowed": {
      "const": false,
      "default": false,
      "title": "Formal Draft Allowed",
      "type": "boolean"
    },
    "writes_project_truth": {
      "const": false,
      "default": false,
      "title": "Writes Project Truth",
      "type": "boolean"
    },
    "requires_author_review": {
      "const": true,
      "default": true,
      "title": "Requires Author Review",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "task_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Hash",
      "type": "string"
    }
  },
  "required": [
    "writer_task_id",
    "mode",
    "run_id",
    "workflow_plan_id",
    "workflow_plan_hash",
    "final_checkpoint_id",
    "final_checkpoint_hash",
    "creation_handoff_hash",
    "creation_handoff_status",
    "context_pack_id",
    "context_pack_hash",
    "route_receipt_id",
    "route_receipt_hash",
    "operation_package_id",
    "operation_package_hash",
    "project_id",
    "project_revision",
    "project_fingerprint",
    "task_goal",
    "target_files_hash",
    "created_at",
    "task_hash"
  ],
  "title": "WriterTask",
  "type": "object",
  "x-zhimeng-invariants": [
    "the Writer task binds one completed three-step Creation workflow",
    "Writer intent and the presence of bound prose targets determine the mode",
    "an upstream blocked handoff remains risk evidence and does not authorize project writes",
    "author_review_change_proposal requires bound targets; prose targets additionally require an active chapter",
    "selected card IDs and hashes preserve the canonical NLCL route order",
    "formal_draft_allowed and writes_project_truth remain false",
    "task_hash hashes every field except task_hash"
  ]
}
