{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/run-event.schema.json",
  "title": "RunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "event_type", "emitted_at", "data"],
  "properties": {
    "schema": {"const": "zhimeng.run-event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "emitted_at": {"type": "string", "format": "date-time"},
    "data": {"type": "object"}
  }
}
