  "properties": {
    "action": {
      "enum": [
        "list",
        "open",
        "observe",
        "click",
        "fill",
        "press",
        "scroll",
        "navigate",
        "back",
        "forward",
        "reload",
        "screenshot",
        "close",
        "receipt"
