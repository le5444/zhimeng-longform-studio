    "y": {
      "default": 0,
      "title": "Y",
      "type": "integer"
    },
    "receipt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Request id from an earlier uncertain action; receipt reads it without replay.",
      "title": "Receipt Id"
    }
