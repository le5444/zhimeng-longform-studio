          "default": null,
          "title": "Retry Of"
        },
        "progress": {
          "$ref": "#/$defs/SourceImportProgress"
        },
        "source_packet": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreparedLocalSourcePacket"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "distillation_draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/DistillationDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "import_id",
        "query",
        "candidate",
        "status",
        "progress",
        "created_at",
        "updated_at"
      ],
      "title": "LocalSourceImportJob",
      "type": "object"
    },
    "PreparedLocalSourcePacket": {
      "additionalProperties": false,
      "properties": {
        "source_backend": {
          "const": "generic_local_file",
          "default": "generic_local_file",
          "title": "Source Backend",
          "type": "string"
        },
        "source_format": {
          "default": "txt",
          "enum": [
            "txt",
            "epub"
