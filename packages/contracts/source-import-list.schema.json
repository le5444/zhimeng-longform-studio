      "required": [
        "title",
        "author",
        "download_scope",
        "packet_dir",
        "packet_manifest_path",
        "epub_path",
        "downloaded_epub_path",
        "text_path",
        "metadata_path",
        "char_count",
        "chapter_marker_count",
