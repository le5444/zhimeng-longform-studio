          "type": "string"
        },
        "import_id": {
          "pattern": "^source-import-[0-9a-f]{32}$",
          "title": "Import Id",
          "type": "string"
        },
        "provider": {
          "const": "local_file",
          "default": "local_file",
          "title": "Provider",
          "type": "string"
