        },
        "author": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "download_scope": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Download Scope",
          "type": "string"
        },
        "packet_dir": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Packet Dir",
          "type": "string"
