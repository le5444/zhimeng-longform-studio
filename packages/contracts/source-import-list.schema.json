      "required": [
        "import_id",
        "query",
        "candidate",
        "status",
        "progress",
        "created_at",
        "updated_at"
      ],
      "title": "SourceImportJob",
      "type": "object"
    },
    "SourceImportProgress": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "saved_chapters": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saved Chapters"
        },
        "total_chapters": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Chapters"
        },
        "percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
