        "metadata_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Metadata Path",
          "type": "string"
        },
        "char_count": {
          "minimum": 1,
          "title": "Char Count",
          "type": "integer"
        },
        "chapter_marker_count": {
          "minimum": 0,
          "title": "Chapter Marker Count",
          "type": "integer"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/SourceArtifact"
          },
          "maxItems": 32,
          "minItems": 4,
          "title": "Artifacts",
          "type": "array"
        }
