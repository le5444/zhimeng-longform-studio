          "title": "Source Format",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "author": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "download_scope": {
          "const": "full",
          "default": "full",
          "title": "Download Scope",
          "type": "string"
        },
        "packet_dir": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Packet Dir",
          "type": "string"
        },
        "packet_manifest_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Packet Manifest Path",
          "type": "string"
        },
        "packet_source_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Packet Source Path",
          "type": "string"
        },
        "text_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text Path",
          "type": "string"
        },
        "metadata_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Metadata Path",
          "type": "string"
        },
        "char_count": {
          "minimum": 1,
          "title": "Char Count",
          "type": "integer"
        },
        "chapter_marker_count": {
          "minimum": 0,
          "title": "Chapter Marker Count",
          "type": "integer"
        },
        "source_file_size_bytes": {
          "minimum": 1,
          "title": "Source File Size Bytes",
          "type": "integer"
        },
        "source_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source File Sha256",
          "type": "string"
        },
        "packet_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Packet Source Sha256",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/SourceArtifact"
          },
          "maxItems": 32,
          "minItems": 4,
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "title",
        "author",
        "packet_dir",
        "packet_manifest_path",
        "packet_source_path",
        "text_path",
        "metadata_path",
        "char_count",
        "chapter_marker_count",
        "source_file_size_bytes",
        "source_file_sha256",
        "packet_source_sha256",
        "text_sha256",
        "artifacts"
      ],
      "title": "PreparedLocalSourcePacket",
      "type": "object"
    },
    "PreparedSourcePacket": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
