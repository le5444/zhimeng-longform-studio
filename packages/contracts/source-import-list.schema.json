    "SourceImportStatus": {
      "enum": [
        "queued",
        "downloading",
        "source_ready",
        "drafting",
        "awaiting_review",
        "formalizing",
        "completed",
        "cancel_requested",
        "cancelled",
        "failed",
        "interrupted"
