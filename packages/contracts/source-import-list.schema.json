{
  "$defs": {
    "DistillationDraft": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "draft_ready",
          "default": "draft_ready",
          "title": "Status",
          "type": "string"
        },
        "output_dir": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Output Dir",
          "type": "string"
        },
        "cards_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Cards Path",
          "type": "string"
        },
        "report_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Report Path",
          "type": "string"
        },
        "validation_report_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Validation Report Path",
          "type": "string"
        },
        "envelope_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Envelope Path",
          "type": "string"
        },
        "card_count": {
          "minimum": 1,
          "title": "Card Count",
          "type": "integer"
        },
        "requires_review": {
          "const": true,
          "default": true,
          "title": "Requires Review",
          "type": "boolean"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/SourceArtifact"
          },
          "maxItems": 32,
          "minItems": 4,
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "output_dir",
        "cards_path",
        "report_path",
        "validation_report_path",
        "envelope_path",
        "card_count",
        "artifacts"
      ],
      "title": "DistillationDraft",
      "type": "object"
    },
    "FeedbackExperienceCandidate": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "const": 1,
          "default": 1,
          "title": "Index",
          "type": "integer"
        },
        "package_id": {
          "pattern": "^formal-knowledge-promotion-package-[0-9a-f]{32}$",
          "title": "Package Id",
          "type": "string"
        },
        "change_set_id": {
          "pattern": "^changeset-[0-9a-f]{32}$",
          "title": "Change Set Id",
          "type": "string"
        },
        "feedback_candidate_id": {
          "pattern": "^feedback-candidate-[0-9a-f]{32}$",
          "title": "Feedback Candidate Id",
          "type": "string"
        },
        "package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Hash",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "change_set_id",
        "feedback_candidate_id",
        "package_hash",
        "title"
      ],
      "title": "FeedbackExperienceCandidate",
      "type": "object"
    },
    "FeedbackSourceImportJob": {
      "additionalProperties": false,
      "description": "Synthetic source lineage for feedback-derived knowledge review candidates.\n\nThis is not a Tomato/local book import. It only exists so staged formal-knowledge\npackages can become pending knowledge candidates without writing formal knowledge.",
      "properties": {
        "schema": {
          "const": "zhimeng.source-import.v3",
          "default": "zhimeng.source-import.v3",
          "title": "Schema",
          "type": "string"
        },
        "import_id": {
          "pattern": "^source-import-[0-9a-f]{32}$",
          "title": "Import Id",
          "type": "string"
        },
        "provider": {
          "const": "feedback_experience",
          "default": "feedback_experience",
          "title": "Provider",
          "type": "string"
        },
        "query": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/FeedbackExperienceCandidate"
        },
        "status": {
          "$ref": "#/$defs/SourceImportStatus"
        },
        "retry_of": {
          "anyOf": [
            {
              "pattern": "^source-import-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Of"
        },
        "progress": {
          "$ref": "#/$defs/SourceImportProgress"
        },
        "source_packet": {
          "default": null,
          "title": "Source Packet",
          "type": "null"
        },
        "distillation_draft": {
          "default": null,
          "title": "Distillation Draft",
          "type": "null"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "import_id",
        "query",
        "candidate",
        "status",
        "progress",
        "created_at",
        "updated_at"
      ],
      "title": "FeedbackSourceImportJob",
      "type": "object"
    },
    "LocalFileSourceCandidate": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "const": 1,
          "default": 1,
          "title": "Index",
          "type": "integer"
        },
        "source_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_format": {
          "default": "txt",
          "enum": [
            "txt",
            "epub"
          ],
          "title": "Source Format",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "author": {
          "default": "unknown",
          "maxLength": 300,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "source_size_bytes": {
          "minimum": 1,
          "title": "Source Size Bytes",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_locator_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Locator Hash",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "title",
        "source_size_bytes",
        "source_sha256",
        "source_locator_hash"
      ],
      "title": "LocalFileSourceCandidate",
      "type": "object"
    },
    "LocalSourceImportJob": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "zhimeng.source-import.v2",
