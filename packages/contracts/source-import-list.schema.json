    "SourceArtifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "SourceArtifact",
      "type": "object"
    },
    "SourceImportJob": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "zhimeng.source-import.v1",
          "default": "zhimeng.source-import.v1",
          "title": "Schema",
          "type": "string"
        },
        "import_id": {
          "pattern": "^source-import-[0-9a-f]{32}$",
