        "epub_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Epub Path",
          "type": "string"
        },
        "downloaded_epub_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Downloaded Epub Path",
          "type": "string"
        },
        "text_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text Path",
          "type": "string"
