        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "delete"
              }
            }
          },
          "then": {
            "properties": {
              "before_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "after_sha256": {
                "type": "null"
              },
              "result_file_id": {
                "type": "null"
              },
              "backup_ref": {
                "type": "string"
              }
            },
            "required": [
              "before_sha256",
              "backup_ref"
            ]
          }
        }
      ],
      "properties": {
        "change_id": {
          "pattern": "^change-[0-9a-f]{32}$",
