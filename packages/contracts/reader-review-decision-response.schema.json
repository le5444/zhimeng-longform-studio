        },
        "rejected_hunk_ids": {
          "items": {
            "pattern": "^hunk-[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Rejected Hunk Ids",
          "type": "array",
          "uniqueItems": true
        },
        "backup_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backup Ref"
        }
      },
      "required": [
