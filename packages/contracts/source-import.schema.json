{
  "$defs": {
    "DistillationDraft": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "draft_ready",
          "default": "draft_ready",
          "title": "Status",
          "type": "string"
        },
        "output_dir": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Output Dir",
          "type": "string"
        },
        "cards_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Cards Path",
          "type": "string"
        },
        "report_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Report Path",
          "type": "string"
        },
        "validation_report_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Validation Report Path",
          "type": "string"
        },
        "envelope_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Envelope Path",
          "type": "string"
        },
        "card_count": {
          "minimum": 1,
          "title": "Card Count",
          "type": "integer"
        },
        "requires_review": {
          "const": true,
          "default": true,
          "title": "Requires Review",
          "type": "boolean"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/SourceArtifact"
          },
          "maxItems": 32,
          "minItems": 4,
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "output_dir",
        "cards_path",
        "report_path",
        "validation_report_path",
        "envelope_path",
        "card_count",
        "artifacts"
      ],
      "title": "DistillationDraft",
      "type": "object"
    },
    "PreparedSourcePacket": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "author": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "download_scope": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Download Scope",
          "type": "string"
        },
        "packet_dir": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Packet Dir",
          "type": "string"
        },
        "packet_manifest_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Packet Manifest Path",
          "type": "string"
        },
        "epub_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Epub Path",
          "type": "string"
        },
        "downloaded_epub_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Downloaded Epub Path",
          "type": "string"
        },
        "text_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text Path",
          "type": "string"
        },
        "metadata_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Metadata Path",
          "type": "string"
        },
        "char_count": {
          "minimum": 1,
          "title": "Char Count",
          "type": "integer"
        },
        "chapter_marker_count": {
          "minimum": 0,
          "title": "Chapter Marker Count",
          "type": "integer"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/SourceArtifact"
          },
          "maxItems": 32,
          "minItems": 4,
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "title",
        "author",
        "download_scope",
        "packet_dir",
        "packet_manifest_path",
        "epub_path",
        "downloaded_epub_path",
        "text_path",
        "metadata_path",
        "char_count",
        "chapter_marker_count",
        "artifacts"
      ],
      "title": "PreparedSourcePacket",
      "type": "object"
    },
    "SourceArtifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "SourceArtifact",
      "type": "object"
    },
    "SourceImportProgress": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "saved_chapters": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saved Chapters"
        },
        "total_chapters": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Chapters"
        },
        "percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percent"
        }
      },
      "required": [
        "stage",
        "message"
      ],
      "title": "SourceImportProgress",
      "type": "object"
    },
    "SourceImportStatus": {
      "enum": [
        "queued",
        "downloading",
        "source_ready",
        "drafting",
        "awaiting_review",
        "formalizing",
        "completed",
        "cancel_requested",
        "cancelled",
        "failed",
        "interrupted"
      ],
      "title": "SourceImportStatus",
      "type": "string"
    },
    "TomatoSearchCandidate": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "book_id": {
          "pattern": "^[0-9]{1,32}$",
          "title": "Book Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "author": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        }
      },
      "required": [
        "index",
        "book_id",
        "title",
        "author"
      ],
      "title": "TomatoSearchCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.source-import.v1",
      "default": "zhimeng.source-import.v1",
      "title": "Schema",
      "type": "string"
    },
    "import_id": {
      "pattern": "^source-import-[0-9a-f]{32}$",
      "title": "Import Id",
      "type": "string"
    },
    "provider": {
      "const": "tomato",
      "default": "tomato",
      "title": "Provider",
      "type": "string"
    },
    "query": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/TomatoSearchCandidate"
    },
    "status": {
      "$ref": "#/$defs/SourceImportStatus"
    },
    "retry_of": {
      "anyOf": [
        {
          "pattern": "^source-import-[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Of"
    },
    "progress": {
      "$ref": "#/$defs/SourceImportProgress"
    },
    "source_packet": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreparedSourcePacket"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "distillation_draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/DistillationDraft"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 8000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "import_id",
    "query",
    "candidate",
    "status",
    "progress",
    "created_at",
    "updated_at"
  ],
  "title": "SourceImportJob",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/source-import.schema.json"
}
