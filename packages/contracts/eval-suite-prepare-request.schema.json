{
  "$defs": {
    "EvalSuiteMemberRequest": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "pattern": "^project-[0-9a-f]{24}$",
          "title": "Project Id",
          "type": "string"
        },
        "change_set_id": {
          "pattern": "^changeset-[0-9a-f]{32}$",
          "title": "Change Set Id",
          "type": "string"
        },
        "expected_baseline_receipt_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Baseline Receipt Id"
        },
        "expected_baseline_receipt_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Baseline Receipt Hash"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "project_id",
        "change_set_id"
      ],
      "title": "EvalSuiteMemberRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.eval-suite-prepare-request.v1",
      "default": "zhimeng.eval-suite-prepare-request.v1",
      "title": "Schema",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/EvalSuiteMemberRequest"
      },
      "maxItems": 32,
      "minItems": 2,
      "title": "Members",
      "type": "array"
    }
  },
  "required": [
    "title",
    "summary",
    "members"
  ],
  "title": "EvalSuitePrepareRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/eval-suite-prepare-request.schema.json"
}
