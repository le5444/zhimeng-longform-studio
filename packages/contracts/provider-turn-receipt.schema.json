{
  "$defs": {
    "MessageUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "title": "MessageUsage",
      "type": "object"
    }
  },
  "$id": "https://zhimeng.local/contracts/provider-turn-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_reported_models": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Accepted Reported Models",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "finish_reason": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Finish Reason",
      "type": "string"
    },
    "model_identity_status": {
      "enum": [
        "exact_match",
        "accepted_alias",
        "unreported",
        "rejected_mismatch"
      ],
      "title": "Model Identity Status",
      "type": "string"
    },
    "provider_boundary_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provider Boundary Hash",
      "type": "string"
    },
    "provider_boundary_id": {
      "pattern": "^provider-io-[0-9a-f]{32}$",
      "title": "Provider Boundary Id",
      "type": "string"
    },
    "receipt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Hash",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^provider-turn-receipt-[0-9a-f]{32}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "reported_model": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reported Model"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "requested_model": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Requested Model"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema": {
      "const": "zhimeng.provider-turn-receipt.v1",
      "default": "zhimeng.provider-turn-receipt.v1",
      "title": "Schema",
      "type": "string"
    },
    "turn_ordinal": {
      "maximum": 8,
      "minimum": 1,
      "title": "Turn Ordinal",
      "type": "integer"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/MessageUsage"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "receipt_id",
    "run_id",
    "provider_boundary_id",
    "provider_boundary_hash",
    "turn_ordinal",
    "request_hash",
    "requested_model",
    "reported_model",
    "accepted_reported_models",
    "model_identity_status",
    "finish_reason",
    "usage",
    "created_at",
    "receipt_hash"
  ],
  "title": "ProviderTurnReceipt",
  "type": "object",
  "x-zhimeng-invariants": [
    "receipt_id is derived from run_id, provider_boundary_id, turn_ordinal and request_hash",
    "receipt_hash hashes every field except receipt_hash",
    "model_identity_status is derived only from exact equality or the explicit accepted_reported_models allowlist",
    "unreported is the only status permitted when reported_model is null",
    "turn receipts are append-only and must be persisted before executing response ToolCalls"
  ]
}
