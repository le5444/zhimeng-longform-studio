{
  "$defs": {
    "ProjectBindingSummary": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "pattern": "^project-[0-9a-f]{24}$",
          "title": "Project Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "root_path": {
          "title": "Root Path",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "snapshot_ready": {
          "title": "Snapshot Ready",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "display_name",
        "root_path",
        "revision",
        "snapshot_ready",
        "created_at",
        "updated_at"
      ],
      "title": "ProjectBindingSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.project-bindings.v1",
      "default": "zhimeng.project-bindings.v1",
      "title": "Schema",
      "type": "string"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/ProjectBindingSummary"
      },
      "title": "Projects",
      "type": "array"
    }
  },
  "required": [
    "projects"
  ],
  "title": "ProjectBindingListResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/project-bindings.schema.json"
}
