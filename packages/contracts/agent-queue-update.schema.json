{
  "$id": "https://zhimeng.local/contracts/agent-queue-update.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "pause",
        "resume",
        "edit",
        "remove",
        "move"
      ],
      "title": "Action",
      "type": "string"
    },
    "direction": {
      "anyOf": [
        {
          "enum": [
            -1,
            1
          ],
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Direction"
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Id"
    },
    "message": {
      "anyOf": [
        {
          "maxLength": 100000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "revision",
    "action"
  ],
  "title": "QueueUpdate",
  "type": "object"
}
