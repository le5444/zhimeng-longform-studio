{
  "$id": "https://zhimeng.local/contracts/mcp-enabled-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "expected_revision": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    }
  },
  "required": [
    "enabled"
  ],
  "title": "McpEnabledRequest",
  "type": "object"
}
