{
  "$defs": {
    "NlclOriginalPrewriteContextReportReceipt": {
      "additionalProperties": false,
      "description": "Receipt for writing product-native prewrite context report after state sync.\n\nWrites chapter_context/*_prewrite_context_report_latest.{json,md} as a compressed\nhandoff for the next chapter. Does not authorize formal prose.",
      "properties": {
        "schema": {
          "const": "zhimeng.nlcl-original-prewrite-context-report-receipt.v1",
          "default": "zhimeng.nlcl-original-prewrite-context-report-receipt.v1",
          "title": "Schema",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^nlcl-original-prewrite-context-report-[0-9a-f]{32}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "change_set_id": {
          "pattern": "^changeset-[0-9a-f]{32}$",
          "title": "Change Set Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project-[0-9a-f]{24}$",
          "title": "Project Id",
          "type": "string"
        },
        "nlcl_original_novel_state_sync_receipt_id": {
          "pattern": "^nlcl-original-novel-state-sync-[0-9a-f]{32}$",
          "title": "Nlcl Original Novel State Sync Receipt Id",
          "type": "string"
        },
        "nlcl_original_novel_state_sync_receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Nlcl Original Novel State Sync Receipt Hash",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "applied",
            "rolled_back"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "chapter_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Chapter Id",
          "type": "string"
        },
        "canonical_chapter_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Canonical Chapter Key",
          "type": "string"
        },
        "written_files": {
          "items": {
            "$ref": "#/$defs/NlclOriginalPrewriteContextReportWrittenFile"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Written Files",
          "type": "array"
        },
        "report_relative_path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?:chapter_context|07_[^/]+/nlcl_state/chapter_context)/[A-Za-z0-9._-]+_prewrite_context_report_latest\\.json$",
          "title": "Report Relative Path",
          "type": "string"
        },
        "record_mode": {
          "const": "product_bridge_prewrite_context_report",
          "default": "product_bridge_prewrite_context_report",
          "title": "Record Mode",
          "type": "string"
        },
        "original_nlcl_novel_state_synced": {
          "const": true,
          "default": true,
          "title": "Original Nlcl Novel State Synced",
          "type": "boolean"
        },
        "original_nlcl_truth_matrix_synced": {
          "const": true,
          "default": true,
          "title": "Original Nlcl Truth Matrix Synced",
          "type": "boolean"
        },
        "prewrite_context_report_synced": {
          "const": true,
          "default": true,
          "title": "Prewrite Context Report Synced",
          "type": "boolean"
        },
        "bounded_library_activated": {
          "default": false,
          "title": "Bounded Library Activated",
          "type": "boolean"
        },
        "nlcl_original_bounded_library_activation_receipt_id": {
          "anyOf": [
            {
              "pattern": "^nlcl-original-bounded-library-activation-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nlcl Original Bounded Library Activation Receipt Id"
        },
        "nlcl_original_bounded_library_activation_receipt_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nlcl Original Bounded Library Activation Receipt Hash"
        },
        "activated_source_count": {
          "default": 0,
          "maximum": 64,
          "minimum": 0,
          "title": "Activated Source Count",
          "type": "integer"
        },
        "whole_library_load_forbidden": {
          "const": true,
          "default": true,
          "title": "Whole Library Load Forbidden",
          "type": "boolean"
        },
        "formal_draft_allowed": {
          "const": false,
          "default": false,
          "title": "Formal Draft Allowed",
          "type": "boolean"
        },
        "quality_assessed": {
          "const": false,
          "default": false,
          "title": "Quality Assessed",
          "type": "boolean"
        },
        "novel_state_synced": {
          "const": true,
          "default": true,
          "title": "Novel State Synced",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Hash",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "change_set_id",
        "project_id",
        "nlcl_original_novel_state_sync_receipt_id",
        "nlcl_original_novel_state_sync_receipt_hash",
        "outcome",
        "chapter_id",
        "canonical_chapter_key",
        "written_files",
        "report_relative_path",
        "created_at",
        "receipt_hash"
      ],
      "title": "NlclOriginalPrewriteContextReportReceipt",
      "type": "object"
    },
    "NlclOriginalPrewriteContextReportWrittenFile": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^(?:chapter_context|07_[^/]+/nlcl_state/chapter_context)/[A-Za-z0-9._-]+_prewrite_context_report_(?:latest|post_writeback)\\.(?:json|md)$",
          "title": "Relative Path",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "kind": {
          "enum": [
            "json_latest",
            "md_latest",
            "json_stage",
            "md_stage"
          ],
          "title": "Kind",
          "type": "string"
        },
        "created": {
          "title": "Created",
          "type": "boolean"
        }
      },
      "required": [
        "relative_path",
        "source_hash",
        "kind",
        "created"
      ],
      "title": "NlclOriginalPrewriteContextReportWrittenFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.nlcl-original-prewrite-context-report-response.v1",
      "default": "zhimeng.nlcl-original-prewrite-context-report-response.v1",
      "title": "Schema",
      "type": "string"
    },
    "change_set_id": {
      "pattern": "^changeset-[0-9a-f]{32}$",
      "title": "Change Set Id",
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/NlclOriginalPrewriteContextReportReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "history": {
      "items": {
        "$ref": "#/$defs/NlclOriginalPrewriteContextReportReceipt"
      },
      "maxItems": 32,
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "change_set_id"
  ],
  "title": "NlclOriginalPrewriteContextReportResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/nlcl-original-prewrite-context-report-response.schema.json"
}
