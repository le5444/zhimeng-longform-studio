{
  "$defs": {
    "FourSkillsRawFamily": {
      "enum": [
        "source_ingest",
        "distillation",
        "knowledge_context",
        "creation_suite"
      ],
      "title": "FourSkillsRawFamily",
      "type": "string"
    },
    "FourSkillsWorkflowBindingReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "zhimeng.four-skills-workflow-binding-receipt.v1",
          "default": "zhimeng.four-skills-workflow-binding-receipt.v1",
          "title": "Schema",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^four-skills-workflow-binding-[0-9a-f]{32}$",
          "title": "Binding Id",
          "type": "string"
        },
        "batch_id": {
          "pattern": "^four-skills-raw-adaptation-[0-9a-f]{32}$",
          "title": "Batch Id",
          "type": "string"
        },
        "batch_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Batch Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "bound",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        },
        "workflow_surface": {
          "const": "generic_instruction_workflow",
          "default": "generic_instruction_workflow",
          "title": "Workflow Surface",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/FourSkillsWorkflowBindingStep"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Steps",
          "type": "array"
        },
        "step_count": {
          "maximum": 4,
          "minimum": 4,
          "title": "Step Count",
          "type": "integer"
        },
        "all_bound": {
          "title": "All Bound",
          "type": "boolean"
        },
        "workflow_ready": {
          "title": "Workflow Ready",
          "type": "boolean"
        },
        "executable": {
          "const": false,
          "default": false,
          "title": "Executable",
          "type": "boolean"
        },
        "raw_skill_md_execution": {
          "const": false,
          "default": false,
          "title": "Raw Skill Md Execution",
          "type": "boolean"
        },
        "four_skills_generic_exactly_once": {
          "const": false,
          "default": false,
          "title": "Four Skills Generic Exactly Once",
          "type": "boolean"
        },
        "formal_draft_allowed": {
          "const": false,
          "default": false,
          "title": "Formal Draft Allowed",
          "type": "boolean"
        },
        "writes_project_truth": {
          "const": false,
          "default": false,
          "title": "Writes Project Truth",
          "type": "boolean"
        },
        "policy_version": {
          "const": "local-v1-four-skills-workflow-binding-1",
          "default": "local-v1-four-skills-workflow-binding-1",
          "title": "Policy Version",
          "type": "string"
        },
        "detail": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "bound_at": {
          "format": "date-time",
          "title": "Bound At",
          "type": "string"
        },
        "binding_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Hash",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "batch_id",
        "batch_hash",
        "status",
        "steps",
        "step_count",
        "all_bound",
        "workflow_ready",
        "detail",
        "bound_at",
        "binding_hash"
      ],
      "title": "FourSkillsWorkflowBindingReceipt",
      "type": "object"
    },
    "FourSkillsWorkflowBindingStep": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "$ref": "#/$defs/FourSkillsRawFamily"
        },
        "ordinal": {
          "maximum": 4,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "skill_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "skill_version_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Skill Version Id",
          "type": "string"
        },
        "package_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Fingerprint",
          "type": "string"
        },
        "runner": {
          "const": "instruction_source",
          "default": "instruction_source",
          "title": "Runner",
          "type": "string"
        },
        "executable": {
          "const": false,
          "default": false,
          "title": "Executable",
          "type": "boolean"
        },
        "bound": {
          "title": "Bound",
          "type": "boolean"
        },
        "detail": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "family",
        "ordinal",
        "skill_id",
        "skill_version_id",
        "package_fingerprint",
        "bound",
        "detail"
      ],
      "title": "FourSkillsWorkflowBindingStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.four-skills-workflow-binding-response.v1",
      "default": "zhimeng.four-skills-workflow-binding-response.v1",
      "title": "Schema",
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/FourSkillsWorkflowBindingReceipt"
    },
    "not_claiming": {
      "default": [
        "four_skills_generic_exactly_once",
        "raw_skill_md_execution",
        "deterministic_tool_auto_generation",
        "managed_skill_execution",
        "formal_draft_authorization_unlock",
        "local_v1_exe"
      ],
      "items": {
        "type": "string"
      },
      "title": "Not Claiming",
      "type": "array"
    }
  },
  "required": [
    "receipt"
  ],
  "title": "FourSkillsWorkflowBindingResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/four-skills-workflow-binding-response.schema.json"
}
