{
  "$defs": {
    "EvalCorpusBaselineReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "zhimeng.eval-corpus-baseline-receipt.v1",
          "default": "zhimeng.eval-corpus-baseline-receipt.v1",
          "title": "Schema",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^eval-corpus-baseline-[0-9a-f]{32}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "change_set_id": {
          "pattern": "^changeset-[0-9a-f]{32}$",
          "title": "Change Set Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project-[0-9a-f]{24}$",
          "title": "Project Id",
          "type": "string"
        },
        "baseline_version": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Baseline Version",
          "type": "integer"
        },
        "source_export_receipt_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Export Receipt Id",
          "type": "string"
        },
        "source_export_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Export File Sha256",
          "type": "string"
        },
        "package_schema": {
          "const": "zhimeng.eval-corpus-package.v1",
          "default": "zhimeng.eval-corpus-package.v1",
          "title": "Package Schema",
          "type": "string"
        },
        "present_artifact_kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Present Artifact Kinds",
          "type": "array"
        },
        "artifact_count": {
          "maximum": 64,
          "minimum": 1,
          "title": "Artifact Count",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "formal_draft_allowed": {
          "const": false,
          "default": false,
          "title": "Formal Draft Allowed",
          "type": "boolean"
        },
        "quality_assessed": {
          "const": false,
          "default": false,
          "title": "Quality Assessed",
          "type": "boolean"
        },
        "formal_knowledge_contaminated": {
          "const": false,
          "default": false,
          "title": "Formal Knowledge Contaminated",
          "type": "boolean"
        },
        "training_ready": {
          "const": false,
          "default": false,
          "title": "Training Ready",
          "type": "boolean"
        },
        "policy_version": {
          "const": "local-v1-eval-corpus-baseline-1",
          "default": "local-v1-eval-corpus-baseline-1",
          "title": "Policy Version",
          "type": "string"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Hash",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "change_set_id",
        "project_id",
        "baseline_version",
        "source_export_receipt_id",
        "source_export_file_sha256",
        "present_artifact_kinds",
        "artifact_count",
        "frozen_at",
        "receipt_hash"
      ],
      "title": "EvalCorpusBaselineReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zhimeng.eval-corpus-baseline-response.v1",
      "default": "zhimeng.eval-corpus-baseline-response.v1",
      "title": "Schema",
      "type": "string"
    },
    "change_set_id": {
      "pattern": "^changeset-[0-9a-f]{32}$",
      "title": "Change Set Id",
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvalCorpusBaselineReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "history": {
      "items": {
        "$ref": "#/$defs/EvalCorpusBaselineReceipt"
      },
      "maxItems": 32,
      "title": "History",
      "type": "array"
    },
    "not_claiming": {
      "default": [
        "training_dataset_ready",
        "literary_quality_score",
        "formal_prose_writeback",
        "formal_draft_authorization_unlock",
        "four_skills_generic_exactly_once",
        "local_v1_exe"
      ],
      "items": {
        "type": "string"
      },
      "title": "Not Claiming",
      "type": "array"
    }
  },
  "required": [
    "change_set_id"
  ],
  "title": "EvalCorpusBaselineResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimeng.local/contracts/eval-corpus-baseline-response.schema.json"
}
