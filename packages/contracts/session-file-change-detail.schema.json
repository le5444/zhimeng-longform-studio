        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "target_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Path"
        },
        "undone_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Undone At"
        }
      },
      "required": [
        "sequence",
        "operation",
        "path",
        "target_path",
        "undone_at"
      ],
      "title": "FileChangePreview",
      "type": "object"
    }
