      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "undo_available": {
      "title": "Undo Available",
      "type": "boolean"
    },
    "undo_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Undo Reason"
