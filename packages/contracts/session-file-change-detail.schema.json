  "$id": "https://zhimeng.local/contracts/session-file-change-detail.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "change_id": {
      "title": "Change Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileChangeItem"
      },
      "title": "Files",
      "type": "array"
    },
    "previews": {
      "items": {
        "$ref": "#/$defs/FileChangePreview"
      },
      "title": "Previews",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
