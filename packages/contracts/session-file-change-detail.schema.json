          "type": "integer"
        },
        "operation": {
          "enum": [
            "create",
            "update",
            "delete",
            "move",
            "mkdir"
          ],
          "title": "Operation",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "preview_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
