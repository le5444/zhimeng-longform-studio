            "create",
            "update",
            "delete",
            "move",
            "mkdir"
          ],
          "title": "Operation",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "target_path": {
